{
  "name": "relay",
  "productName": "Relay",
  "version": "0.1.0",
  "private": false,
  "description": "One desktop chat that coordinates the AI tools you already use, and can open a real Linux machine.",
  "author": "Manjeet Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manjeetsingh-satveer/Relay.git"
  },
  "homepage": "https://github.com/manjeetsingh-satveer/Relay",
  "bugs": {
    "url": "https://github.com/manjeetsingh-satveer/Relay/issues"
  },
  "type": "module",
  "main": "dist/desktop.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n ui,api \"vite --host 127.0.0.1 --port 43123\" \"tsx src/server/cli.ts --port 43124 --data ./data\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:ui": "vite build",
    "build:server": "esbuild src/server/cli.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:electron --external:playwright-core",
    "build:desktop": "esbuild src/desktop/main.ts --bundle --platform=node --format=cjs --outfile=dist/desktop.cjs --external:electron --external:playwright-core",
    "build": "npm run build:ui && npm run build:server && npm run build:desktop",
    "start": "node dist/server.mjs --port 43123 --data ./data --static dist/ui",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "playwright-core": "^1.58.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
